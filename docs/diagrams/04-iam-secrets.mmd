flowchart LR
    classDef user fill:#FEF3C7,stroke:#D97706,color:#451A03
    classDef role fill:#FEE2E2,stroke:#DC2626,color:#450A0A
    classDef res fill:#E0F2FE,stroke:#0284C7,color:#082F49
    classDef var fill:#F3F4F6,stroke:#6B7280,color:#111
    classDef deny fill:#111827,stroke:#111827,color:#fff

    subgraph GITLAB["GitLab CI/CD variables"]
        VPLAN["AWS_PLAN_* · masked<br/>(any pipeline, incl. MRs)"]:::var
        VDEP["AWS_DEPLOY_* · masked + PROTECTED<br/>(only pipelines on protected main)"]:::var
    end

    subgraph CIIAM["CI identities (infra/bootstrap)"]
        UPLAN["IAM user guestbook-ci-plan<br/>only permission: sts:AssumeRole<br/>on role guestbook-ci-plan"]:::user
        UDEP["IAM user guestbook-ci-deploy<br/>only permission: sts:AssumeRole<br/>on role guestbook-ci-deploy"]:::user
        RPLAN["Role guestbook-ci-plan · 1 h session<br/>ReadOnlyAccess + state-bucket RW"]:::role
        RDEP["Role guestbook-ci-deploy · 1 h session<br/>services: ec2 ecs elb rds logs cloudwatch sns events<br/>backup kms secretsmanager cloudfront wafv2 autoscaling<br/>condition: aws:RequestedRegion ∈ {eu-north-1, us-east-1}<br/>s3:* only guestbook-* · ecr:* only guestbook-api<br/>iam:* only guestbook-dev-* / guestbook-prod-*<br/>iam:PassRole only to ecs-tasks / backup / flow-logs"]:::role
        DENY["Explicit DENY iam:*<br/>on guestbook-ci-* users, roles, policies<br/>(no self-escalation)"]:::deny
    end

    subgraph RUNTIME["Runtime identities (infra/modules)"]
        EXEC["Role guestbook-dev-api-execution<br/>(used by the ECS agent)<br/>AmazonECSTaskExecutionRolePolicy<br/>+ GetSecretValue on ONE secret<br/>+ kms:Decrypt on ONE key"]:::role
        TASK["Role guestbook-dev-api-task<br/>(used by the app code)<br/>NO permissions"]:::role
        BKR["Role guestbook-dev-backup<br/>AWSBackupServiceRolePolicyForBackup/Restores"]:::role
        FLR["Role guestbook-dev-vpc-flow-logs<br/>PutLogEvents on one log group"]:::role
    end

    SECRET[("Secrets Manager<br/>rds!db-… master secret<br/>generated + rotated by RDS<br/>encrypted with KMS main key")]:::res
    CONT["API container<br/>env DB_PASSWORD injected at start<br/>(never in image, repo, CI, logs, tfstate)"]:::res

    VPLAN --> UPLAN -->|AssumeRole| RPLAN
    VDEP --> UDEP -->|AssumeRole| RDEP
    RDEP -.- DENY
    RDEP -->|"iam:PassRole"| EXEC & TASK & BKR & FLR
    EXEC -->|"GetSecretValue + Decrypt"| SECRET
    SECRET -->|"valueFrom …:password::"| CONT
    TASK -.->|"identity of the process"| CONT
