flowchart LR
    classDef lint fill:#E0F2FE,stroke:#0284C7,color:#082F49
    classDef test fill:#DCFCE7,stroke:#16A34A,color:#052e16
    classDef build fill:#FEF3C7,stroke:#D97706,color:#451A03
    classDef sec fill:#FEE2E2,stroke:#DC2626,color:#450A0A
    classDef dep fill:#EDE9FE,stroke:#7C3AED,color:#2E1065
    classDef man fill:#111827,stroke:#111827,color:#fff
    classDef art fill:#FFFFFF,stroke:#9CA3AF,color:#374151,stroke-dasharray: 4 3

    TRIG(["git push / merge request"])

    subgraph S1["① lint · no credentials · MR + main"]
        L1["lint:python<br/>ruff check + format"]:::lint
        L2["lint:dockerfile<br/>hadolint (warnings fail)"]:::lint
        L3["lint:terraform<br/>fmt -check · validate"]:::lint
        L4["lint:tflint<br/>terraform + aws rulesets"]:::lint
        L5["security:checkov<br/>279 pass / 0 fail"]:::sec
        L6["security:gitleaks<br/>full history (GIT_DEPTH 0)"]:::sec
    end

    subgraph S2["② test · MR + main"]
        T1["test:unit<br/>pytest · JUnit · Cobertura 79 %"]:::test
        T2["sonarqube<br/>quality gate (wait)"]:::test
    end

    B1["③ build:image<br/>docker build --pull<br/>tag :sha · OCI labels"]:::build
    A1[/"image.tar.gz"/]:::art
    S4["④ scan:trivy<br/>fail on fixable HIGH/CRITICAL<br/>GitLab container-scanning report"]:::sec
    P1["⑤ publish:image (main)<br/>deploy role · ECR :sha (immutable)<br/>Docker Hub :sha + :latest"]:::build
    PL["⑥ plan:dev<br/>READ-ONLY role · plan -out=tfplan<br/>MR Terraform widget"]:::dep
    A2[/"tfplan"/]:::art
    D1["⑦ deploy:dev (main)<br/>deploy role · record PREV_TASK_DEF<br/>apply tfplan · wait services-stable<br/>s3 sync · CloudFront invalidation"]:::dep
    A3[/"deploy.env<br/>APP_URL · PREV_TASK_DEF"/]:::art
    V1["⑧ smoke:dev<br/>HTTPS · 301 · version == sha<br/>DB ready · write/read"]:::test
    R1["⑨ rollback:dev<br/>when: on_failure<br/>ECS → PREV_TASK_DEF"]:::sec
    PR["⑩ deploy:prod<br/>MANUAL approval<br/>same image · prod tfvars"]:::man

    TRIG --> S1
    S1 --> T1 --> T2
    L2 & T1 --> B1 --> A1 --> S4 --> P1
    L3 & L5 --> PL --> A2
    A2 & P1 --> D1 --> A3 --> V1
    V1 -->|"pass"| PR
    V1 -->|"fail"| R1
    D1 -->|"fail"| R1
